{
  "name": "kernext",
  "private": true,
  "version": "0.1.0",
  "description": "KERNEXT — The Next Core of Computing.",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "cargo run -p shell-server",
    "web:dev": "pnpm --filter @kernext/web dev",
    "web:build": "pnpm --filter @kernext/web build",
    "web:preview": "pnpm --filter @kernext/web preview",
    "web:typecheck": "pnpm --filter @kernext/web typecheck",
    "web:test": "pnpm --filter @kernext/web test",
    "desktop:dev": "pnpm --filter @kernext/desktop dev",
    "desktop:build": "pnpm --filter @kernext/desktop build",
    "typecheck": "pnpm web:typecheck",
    "build": "pnpm web:build",
    "test": "pnpm web:test"
  }
}
