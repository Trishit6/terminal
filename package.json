{
  "name": "kernext",
  "private": true,
  "version": "0.1.0",
  "description": "KERNEXT — The Next Core of Computing.",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "cargo run -p shell-server",
    "web:dev": "npm run dev -w @kernext/web",
    "web:build": "npm run build -w @kernext/web",
    "web:preview": "npm run preview -w @kernext/web",
    "web:typecheck": "npm run typecheck -w @kernext/web",
    "web:test": "npm run test -w @kernext/web",
    "desktop:dev": "npm run dev -w @kernext/desktop",
    "desktop:build": "npm run build -w @kernext/desktop",
    "typecheck": "npm run web:typecheck",
    "build": "npm run web:build",
    "test": "npm run web:test"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  }
}
