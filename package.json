{
  "name": "kernext",
  "private": true,
  "version": "0.1.0",
  "description": "KERNEXT — The Next Core of Computing.",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "web:dev": "pnpm --filter @kernext/web dev",
