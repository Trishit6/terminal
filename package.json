{
  "name": "kernext",
  "private": true,
  "version": "0.1.0",
  "description": "KERNEXT — The Next Core of Computing.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "cargo run -p shell-server",
    "web:dev": "pnpm --filter @kernext/web run dev",
    "web:build": "pnpm --filter @kernext/web run build",
    "web:preview": "pnpm --filter @kernext/web run preview",
    "web:typecheck": "pnpm --filter @kernext/web run typecheck",
    "web:test": "pnpm --filter @kernext/web run test",
    "desktop:dev": "pnpm --filter @kernext/desktop run dev",
    "desktop:build": "pnpm --filter @kernext/desktop run build",
    "typecheck": "pnpm run web:typecheck",
    "build": "pnpm run web:build",
    "test": "pnpm run web:test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  }
}
