[TEMPLATE]
# KERNEXT Authentication Configuration
# Copy this file to .env and fill in real credentials.
# The .env file is gitignored and must not be committed.

# --- Website (SEO / deployment) ---
# The public origin of the deployed KERNEXT website, without a trailing
# slash. When set, the web client emits canonical URLs and og:url/og:image
# metadata, and `scripts/seo.mjs` generates dist/sitemap.xml with real
# URLs and patches dist/index.html. Leave it empty until a real domain is
# connected — a placeholder here would be published as the canonical
# domain, which is worse than none.
# Example: https://kernext.example.org
VITE_PUBLIC_SITE_URL=

# --- Database ---
# MariaDB connection URL when running with accounts enabled.
# Format: mysql://USER:PASSWORD@127.0.0.1:3307/DATABASE_NAME
# Development: use a dedicated database and user on port 3307.
DATABASE_URL=

# --- Server ---
KERNEXT_SERVER_URL=http://127.0.0.1:7878
KERNEXT_SERVER_BIND=0.0.0.0:7878

# Optional explicit path to the env file. Without it the backend checks
# ./.env and then the workspace-root .env, so the launch directory does not
# decide whether accounts load.
# KERNEXT_ENV_FILE=/absolute/path/to/.env

# --- Development administrator seed ---
# Opt-in only, and never applied when KERNEXT_ENV=production. The account is
# created once; an existing email is left untouched. These are development
# credentials: change the password on first sign-in.
KERNEXT_SEED_ADMIN=false
KERNEXT_ADMIN_USERNAME=admin
KERNEXT_ADMIN_EMAIL=admin@admin.com
KERNEXT_ADMIN_PASSWORD=password

# Public application URL used in verification and password-reset links.
# Example: https://kernext.example.org
APP_PUBLIC_URL=http://127.0.0.1:7878

# Comma-separated browser origins allowed to call the API. Leave empty for
# the built-in local Vite/Tauri allowlist. Example:
# KERNEXT_ALLOWED_ORIGINS=https://kernext.example.org
KERNEXT_ALLOWED_ORIGINS=

# --- SMTP (email) ---
# Set KERNEXT_ENV=production to require valid SMTP settings.
# Email is NOT pretended: without SMTP and without KERNEXT_DEV_MAIL, recovery
# and verification links are not delivered and the API says so.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Cookie & Security ---
# Produce secure cookies (and HSTS) only in production, or set
# KERNEXT_SECURE_COOKIES=1 explicitly. KERNEXT_ENV=production also disables
# the development mail fallback.
KERNEXT_SECURE_COOKIES=0
KERNEXT_ENV=development

# --- Dev mail fallback ---
# When set to "1" and KERNEXT_ENV is not "production", the API returns
# development-only reset/verification tokens instead of sending email.
KERNEXT_DEV_MAIL=1

# Account endpoints apply built-in fixed-window rate limits per client and
# email; they are not configurable through environment variables.

# --- Integration tests ---
# Disposable database used by `cargo test -p shell-server --test auth_db`.
# Never point this at production. The harness refuses a DATABASE_URL fallback
# unless the database name contains "test".
# KERNEXT_TEST_DATABASE_URL=mysql://kernext:CHANGE_ME@127.0.0.1:3307/kernext_test
