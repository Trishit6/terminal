# KERNEXT Authentication Configuration
# Copy this file to .env and fill in real credentials.
# The .env file is gitignored and must not be committed.

# --- Website (SEO / deployment) ---
# The public origin of the deployed KERNEXT website, without a trailing
# slash. When set, the web client emits canonical URLs and og:url/og:image
# metadata, and `scripts/seo.mjs` generates dist/sitemap.xml with real
# URLs and patches dist/index.html. Leave it empty until a real domain is
# connected — a placeholder here would be published as the canonical
# domain, which is worse than none.
# Example: https://kernext.example.org
VITE_PUBLIC_SITE_URL=

# --- Database ---
# MariaDB connection URL when running with accounts enabled.
# Format: mysql://USER:PASSWORD@127.0.0.1:3307/DATABASE_NAME
DATABASE_URL=

# --- Server ---
KERNEXT_SERVER_URL=http://127.0.0.1:7878
KERNEXT_SERVER_BIND=0.0.0.0:7878

# --- SMTP (email) ---
# Set KERNEXT_ENV=production to require valid SMTP settings.
# Email is NOT pretended in development with KERNEXT_DEV_MAIL=1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Cookie & Security ---
# Produce secure cookies only in production, or set KERNEXT_SECURE_COOKIES=1.
KERNEXT_SECURE_COOKIES=0
KERNEXT_ENV=development

# --- Dev mail fallback ---
# When set to "1" and KERNEXT_ENV is not "production", emails are sent
# without requiring SMTP credentials (development only).
KERNEXT_DEV_MAIL=1

# --- Rate limiting ---
# Fixed-window rate limit per IP, default 100 requests per 60 seconds.
RATE_LIMIT_COUNT=100
RATE_LIMIT_PERIOD=60