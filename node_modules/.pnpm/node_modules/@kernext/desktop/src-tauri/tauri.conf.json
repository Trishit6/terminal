{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KERNEXT",
  "version": "0.1.0",
  "identifier": "dev.kernext.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @kernext/web dev",
    "devUrl": "http://127.0.0.1:5173/desktop",
    "beforeBuildCommand": "pnpm --filter @kernext/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "KERNEXT",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "theme": "Dark",
        "url": "/desktop"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "KERNEXT desktop shell",
    "longDescription": "KERNEXT — The Next Core of Computing. A native Rust shell with a desktop terminal, command explorer, file explorer, and session manager.",
    "copyright": "© 2026 KERNEXT"
  }
}
